extends ../../layouts/default.pug

include ../../mixins/hierarchy-category.pug

block main

    doctype html
    html(lang="vi")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title Quản Lý Danh Mục - SP Shop Admin (Tối Ưu)
        link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet")
        link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
        style.
            

    body    
        .table-container
            .category-header
                h2.category-title Cấu Trúc Danh Mục
                .search-box
                    input.search-input#searchInput(type="text" placeholder="Tìm kiếm danh mục...")
                    i.fas.fa-search.search-icon
                a.btn-add-category(href=`/admin/category/create/new`)
                    i.fas.fa-plus
                    span Thêm danh mục
            
            .filter-section
                span.filter-label Lọc theo trạng thái:
                .filter-buttons
                    button.filter-btn.active(data-filter="all" onclick="filterCategories('all')")
                        i.fas.fa-list
                        span Tất cả
                    button.filter-btn(data-filter="active" onclick="filterCategories('active')")
                        i.fas.fa-check-circle
                        span Hoạt động
                    button.filter-btn(data-filter="inactive" onclick="filterCategories('inactive')")
                        i.fas.fa-pause-circle
                        span Ngừng hoạt động
            
            .category-tree#categoryTree
                if categories.length > 0
                    each category in categories
                        +CategoryNode(category, 1)
                else
                    h1 Bạn chưa có danh mục sản phẩm nào!

               

block script
    script(src="/admin/js/category.index.js") 
        
extends ../../layouts/default.pug

block styles
    link(rel="stylesheet", href="/admin/css/category.create.css")

block main 
    // Content Area
    .content-area
        // Form Container
        .form-container.fade-in
            .form-header
                h2.form-title
                    i.fas.fa-plus-circle
                    |  Thông tin danh mục
                .form-actions
                    button.btn-preview(type="button" onclick="previewCategory()")
                        i.fas.fa-eye
                        |  Xem trước
            
            form(action="/admin/category/create", method="post" id="categoryForm") 
                // Basic Information Section
                .form-section
                    h3.section-title
                        i.fas.fa-info-circle
                        |  Thông tin cơ bản
                    
                    .row
                        .col-md-6
                            .form-group
                                label.form-label
                                    | Tên danh mục 
                                    span.required *
                                input.form-control#categoryName(
                                    name="title" 
                                    type="text" 
                                    placeholder="Ví dụ: Thời trang nam" required
                                )
                        .col-md-6
                            .form-group
                                label.form-label Danh mục cha
                                select(
                                    class="form-select"
                                    id="parentCategory"
                                    name="parent_id"
                                )
                                    option(value="" selected=(id != "" ? false : true)) -- Không có -- (Danh mục cấp 1)
                                    each category in categories
                                        option(value=category.id selected=(id == category.id ? true : false)) #{category.title}
                        
                    .row
                        .col-md-6
                            .form-group
                                label.form-label Thứ tự sắp xếp
                                input.form-control#categorySort(
                                    name="position"
                                    type="number" 
                                    placeholder="0" 
                                    min="0"
                                )
                        .col-md-6
                            .form-group
                                label.form-label Icon danh mục
                                .icon-selector#iconSelector
                                input(
                                    name="icon_category"
                                    type="hidden"
                                    id="categoryIcon"
                                    value="fa-tshirt"
                                )
                    
                    .form-group
                        label.form-label Mô tả
                        textarea.form-control#categoryDescription(
                            name="description"
                            rows="6"
                            placeholder="Mô tả ngắn gọn về danh mục"
                        )
                    
                
                // SEO Section
                .form-section
                    h3.section-title
                        i.fas.fa-search
                        |  Cấu hình SEO
                    
                    .form-group
                        label.form-label Đường dẫn SEO (Slug)
                        input.form-control#categorySlug(
                            name="slug"
                            type="text" 
                            placeholder="thoi-trang-nam"
                        )
                        small.form-text.text-muted Đường dẫn sẽ được tự động tạo từ tên danh mục
                    
                    .form-group
                        label.form-label Tiêu đề SEO
                        input.form-control#seoTitle(
                            name="seo_title"
                            type="text"
                            placeholder="Tiêu đề tối ưu cho công cụ tìm kiếm"
                        )
                    
                    .form-group
                        label.form-label Mô tả Meta
                        textarea.form-control#metaDescription(
                            name="meta_description"
                            rows="3" 
                            placeholder="Mô tả ngắn gọn hiển thị trên kết quả tìm kiếm (tối đa 160 ký tự)"
                        )
                        small.form-text.text-muted
                            span#metaCharCount 0
                            | /160 ký tự
                    
                    .form-group
                        label.form-label Từ khóa Meta
                        input.form-control#metaKeywords(
                            name="meta_keywords"
                            type="text" 
                            placeholder="thời trang, quần áo, nam"
                        )
                        small.form-text.text-muted Phân tách bằng dấu phẩy

                
                    
                
                // Display Options Section
                .form-section
                    h3.section-title
                        i.fas.fa-eye
                        |  Tùy chọn hiển thị
                    
                    .row
                        .col-md-6
                            .form-group
                                .form-switch
                                    input.form-check-input#isActive(
                                        name="status"
                                        type="checkbox" checked)
                                    label.form-check-label(for="isActive")
                                        | Hoạt động
                                small.form-text.text-muted Danh mục sẽ hiển thị trên cửa hàng
                        .col-md-6
                            .form-group
                                .form-switch
                                    input.form-check-input#showOnHomepage(type="checkbox")
                                    label.form-check-label(for="showOnHomepage")
                                        | Hiển thị trên trang chủ
                                small.form-text.text-muted Hiển thị danh mục này trên trang chủ
                .text-end.mt-3
                    button.btn-save(type="submit" onclick="saveCategory()")
                        i.fas.fa-save
                        |  Lưu



    // Preview Modal
    .modal.fade#previewModal(tabindex="-1")
        .modal-dialog.modal-lg
            .modal-content
                .modal-header
                    h5.modal-title
                        i.fas.fa-eye
                        |  Xem trước danh mục
                    button.btn-close(type="button" data-bs-dismiss="modal")
                .modal-body
                    .category-preview
                        .category-item.level-1
                            span.status-badge.active
                                i.fas.fa-circle(style="font-size: 8px;")
                                |  Hoạt động
                            .category-info
                                i.fas.fa-tshirt#previewIcon
                                span.category-name#previewName Thời trang nam
                                .category-stats
                                    span
                                        i.fas.fa-box
                                        |  0 sản phẩm
                                    span
                                        i.fas.fa-folder
                                        |  0 danh mục con
                            .category-actions
                                button.btn-action.btn-detail(type="button")
                                    i.fas.fa-info-circle
                                button.btn-action.btn-edit(type="button")
                                    i.fas.fa-edit
                                button.btn-action.btn-delete(type="button")
                                    i.fas.fa-trash
                        
                        .mt-4
                            h6 Chi tiết danh mục:
                            table.table.table-striped
                                tr
                                    td(width="150") Tên danh mục:
                                    td#previewDetailName Thời trang nam
                                tr
                                    td Danh mục cha:
                                    td#previewDetailParent Thời trang
                                tr
                                    td Slug:
                                    td#previewDetailSlug thoi-trang-nam
                                tr
                                    td Mô tả:
                                    td#previewDetailDescription Mô tả danh mục thời trang nam
                                tr
                                    td Trạng thái:
                                    td#previewDetailStatus Hoạt động

block script
    script(src="/admin/js/category.create.js") 
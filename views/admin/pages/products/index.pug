extends ../../layouts/default

block main 
    .table-container
        .table-header
            .search-box
                input.search-input(type='text', placeholder='Tìm kiếm sản phẩm...')
                i(class="fas fa-search search-icon")
            button.btn-add-product(type='button', data-bs-toggle='modal', data-bs-target='#addProductModal')
                i(class="fas fa-plus")
                span Thêm sản phẩm
        
        .table-responsive
            table.table-custom
                thead
                    tr
                        th STT
                        th Sản phẩm
                        th Giá
                        th Tồn kho
                        th Trạng thái
                        th Thao tác
                    tbody
                        each product, index in products
                            tr
                                td #{index + 1}
                                td
                                    .d-flex.align-items-center.gap-3
                                        img.product-img(src=product.thumbnail, alt=product.title)
                                        div
                                            .product-name #{product.title}
                                            //-.product-category Thời trang nam
                                td #{product.currentPrice}đ
                                td #{product.stock}
                                td
                                    if(product.status=="active")
                                        span.status-badge.in-stock Hoạt động
                                    else 
                                        span.status-badge.out-of-stock Ngừng hoạt động
                                td
                                    .action-buttons
                                        button.btn-action.edit(type='button')
                                            i(class="fas fa-edit")
                                        button.btn-action.delete(type='button')
                                            i(class="fas fa-trash")
                       
    
    // Pagination
    .pagination-container
        .pagination-info Hiển thị 1-6 của 1,284 sản phẩm
        .pagination-custom
            button.page-btn
                i(class="fas fa-chevron-left")
            button.page-btn.active 1
            button.page-btn 2
            button.page-btn 3
            button.page-btn ...
            button.page-btn 214
            button.page-btn
                i(class="fas fa-chevron-right")

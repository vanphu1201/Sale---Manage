extends ../../layouts/default

block main 
    .table-container
        .table-header
            
            .search-box
                form(
                    action="/admin/products", method="get"
                    form-search
                ) 
                    input(
                        class="search-input"
                        type='text'
                        placeholder='Tìm kiếm sản phẩm...'
                        input-search
                        value=searchValue
                    )
                    button(class="fas fa-search search-icon")

            

            a(
                href="/admin/products/create"
                class="btn-add-product"
                data-toggle='modal'
                dat-target='#addProductModal'
            )
                i(class="fas fa-plus")
                span Thêm sản phẩm


        // Filter and Sort Section
        .controls-section
            .filter-section
                span.filter-label Lọc theo trạng thái:
                .filter-buttons.filter-group
                    a.filter-btn(
                        class=(currentStatus == undefined ? "active" : "")
                        class="btn-status"
                        status=""
                    )
                        i.fas.fa-list
                        span Tất cả
                        - const all = quantityStatus.length;
                        span.filter-count #{all}
                    a.filter-btn(
                        class=(currentStatus == "active" ? "active" : "")
                        class="btn-status"
                        status="active"
                    )
                        i.fas.fa-check-circle
                        - const active = (quantityStatus.filter(item => item.status == "active")).length;
                        span Hoạt động
                        span.filter-count #{active}
                    a.filter-btn(
                        class="btn-status"
                        class=(currentStatus == "inactive" ? "active" : "")
                        status="inactive"
                    )
                        i.fas.fa-pause-circle
                        - const inactive = (quantityStatus.filter(item => item.status == "inactive")).length;
                        span Dừng hoạt động
                        span.filter-count #{inactive}


            .sort-section
                .sort-dropdown
                    button.sort-btn(type='button', onclick='toggleSortMenu()')
                        i.fas.fa-sort
                        span Sắp xếp theo
                        i.fas.fa-chevron-down.ms-1
                    .sort-menu#sortMenu
                        .sort-option(data-sort='title-asc')
                            span Tên sản phẩm (a->z)
                            i.fas.fa-sort-alpha-down
                        .sort-option(data-sort='title-desc')
                            span Tên sản phẩm (z->a)
                            i.fas.fa-sort-alpha-up
                        .sort-option(data-sort='price-asc')
                            span Giá (thấp đến cao)
                            i.fas.fa-sort-amount-up
                        .sort-option(data-sort='price-desc')
                            span Giá (cao đến thấp)
                            i.fas.fa-sort-amount-down
                        .sort-option(data-sort='position-desc')
                            span Vị trí (tăng dần)
                            i.fas.fa-sort-amount-up
                        .sort-option(data-sort='position-desc')
                            span Vị trí (giảm dần)
                            i.fas.fa-sort-amount-down

        // Bulk Actions
        .bulk-actions#bulkActions
            .bulk-info Đã chọn <span id="selectedCount">0</span> sản phẩm
            form(
                action="/admin/products/changeMultiStatus"
                method="post"
                form-change-status
            ) 
                button(
                    class="bulk-btn activate"
                    type='submit'
                    active-multi
                )
                    i.fas.fa-check
                    span  Kích hoạt
                button(
                    class="bulk-btn inactivate"
                    type='submit'
                    inactive-multi
                )
                    i.fas.fa-pause
                    span  Ngừng hoạt động
                button(
                    class="bulk-btn delete"
                    type='submit'
                    delete-all
                )
                    i.fas.fa-trash
                    span Xóa
        
        .table-responsive
            table.table-custom
                thead
                    tr
                        th(width='40') 
                            input(
                                class="product-checkboxAll"
                                type='checkbox'
                                id='headerCheckbox'
                                name="check-all"
                                onchange='toggleSelectAll()'
                            )
                        th STT
                        th Sản phẩm
                        th Vị trí
                        th Giá
                        th Tồn kho
                        th Trạng thái
                        th Thao tác
                    tbody
                        each product, index in products
                            tr(
                                box-product
                                product-id=product.id
                            )
                                td 
                                    input(
                                        name="check"
                                        class="product-checkbox"
                                        type='checkbox'
                                        onchange='updateBulkActions()'
                                    )
                                td #{pagination.skip + index + 1}
                                td
                                    .d-flex.align-items-center.gap-3
                                        img.product-img(src=product.thumbnail, alt=product.title)
                                        div
                                            .product-name #{product.title}
                                            //-.product-category Thời trang nam
                                td #{product.position}
                                td #{product.currentPrice}đ
                                td #{product.stock}
                                td
                                    if(product.status=="active")
                                        a(
                                            href=`/admin/products/changeStatus/inactive/${product.id}`
                                            class="status-badge in-stock"
                                            current-status="active"
                                        ) Hoạt động
                                    else 
                                        a(
                                            href=`/admin/products/changeStatus/active/${product.id}`
                                            class="status-badge out-of-stock"
                                            current-status="inactive"
                                        ) Ngừng hoạt động
                                td
                                    .action-buttons
                                        a(
                                            href=`/admin/products/detail/${product.id}`
                                            class="btn-action detail"
                                        )
                                            i(class="fas fa-eye")
                                        a(
                                            href=`/admin/products/edit/${product.id}`
                                            class="btn-action edit"
                                        )
                                            i(class="fas fa-edit")
                                        a(
                                            href=`/admin/products/delete/${product.id}`
                                            class="btn-action delete"
                                        )
                                            i(class="fas fa-trash")
                       
    
    // Pagination
    .pagination-container
        .pagination-info Hiển thị #{pagination.skip + 1}-#{(pagination.countProduct - (pagination.skip + pagination.limit) >= 1 ? (pagination.skip + 10) : (pagination.countProduct - pagination.skip+10))} của #{pagination.countProduct} sản phẩm
        .pagination-custom
            - if (pagination.currentPage > 1)
                button.page-btn-left
                    i(class="fas fa-chevron-left")
            - for(let i = 1; i <= pagination.totalPage; i++)
                button(
                    class="page-btn"
                    page=i
                    class=(pagination.currentPage == i ? "active" : "")
                ) #{i}
            - if (pagination.currentPage < pagination.totalPage)
                button.page-btn-right
                    i(class="fas fa-chevron-right")
extends ../../layouts/default

block main 
    .table-container
        .table-header
            .search-box
                form(action="/admin/products/search", method="post") 
                    input.search-input(type='text', placeholder='Tìm kiếm sản phẩm...')
                    button(class="fas fa-search search-icon")
            button.btn-add-product(type='button', data-bs-toggle='modal', data-bs-target='#addProductModal')
                i(class="fas fa-plus")
                span Thêm sản phẩm
        
        .table-responsive
            table.table-custom
                thead
                    tr
                        th STT
                        th Sản phẩm
                        th Giá
                        th Tồn kho
                        th Trạng thái
                        th Thao tác
                    tbody
                        each product, index in products
                            tr(
                                box-product
                                product-id=product.id
                            )
                                td #{index + 1}
                                td
                                    .d-flex.align-items-center.gap-3
                                        img.product-img(src=product.thumbnail, alt=product.title)
                                        div
                                            .product-name #{product.title}
                                            //-.product-category Thời trang nam
                                td #{product.currentPrice}đ
                                td #{product.stock}
                                td
                                    if(product.status=="active")
                                        a(
                                            href=`/admin/products/changeStatus/inactive/${product.id}`
                                            class="status-badge in-stock"
                                            current-status="active"
                                        ) Hoạt động
                                    else 
                                        a(
                                            href=`/admin/products/changeStatus/active/${product.id}`
                                            class="status-badge out-of-stock"
                                            current-status="inactive"
                                        ) Ngừng hoạt động
                                td
                                    .action-buttons
                                        a(
                                            class="btn-action edit"
                                        )
                                            i(class="fas fa-edit")
                                        a(
                                            href=`/admin/products/delete/${product.id}`
                                            class="btn-action delete"
                                        )
                                            i(class="fas fa-trash")
                       
    
    // Pagination
    .pagination-container
        .pagination-info Hiển thị 1-6 của 1,284 sản phẩm
        .pagination-custom
            button.page-btn
                i(class="fas fa-chevron-left")
            button.page-btn.active 1
            button.page-btn 2
            button.page-btn 3
            button.page-btn ...
            button.page-btn 214
            button.page-btn
                i(class="fas fa-chevron-right")

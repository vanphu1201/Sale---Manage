header.admin-header
    .d-flex.align-items-center.gap-3
        button.sidebar-toggle(type='button')
            i(class="fas fa-bars")
        h1.page-title #{title}
    .header-actions
        button.notification-btn(type='button')
            i(class="far fa-bell")
            span.notification-badge 5
        .user-dropdown
            img.user-avatar(src='https://picsum.photos/seed/admin/100/100.jpg', alt='Admin')
            span Admin User
            i.fas.fa-chevron-down.ms-2
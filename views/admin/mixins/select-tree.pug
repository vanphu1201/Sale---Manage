mixin select-tree(id, items, level = 1)
    each item in items
        - const prefix = Array(level + 1).join("-- ")
        - if (item.parent_id == "")
            option(value=item.id) #{prefix}#{item.title}
        - else
            option(value=item.id selected=(item.id.includes(id) ? true : false)) #{prefix}#{item.title}
        if item.children && item.children.length > 0
            +select-tree(id, item.children, level + 1)